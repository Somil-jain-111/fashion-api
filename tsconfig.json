{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    "esModuleInterop": true,         // ✅ Helps with default imports
    "moduleResolution": "node",      // ✅ Makes import path resolution standard
    "resolveJsonModule": true,       // ✅ Allows importing JSON if needed
    "skipLibCheck": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strict": false,
    "outDir": "./dist",
    "sourceMap": true,
    "incremental": true,
    "baseUrl": "./"
  }
}