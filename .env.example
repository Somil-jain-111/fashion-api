# Product boost pricing and payment webhook verification
BOOST_PRICE_PER_DAY=100
BOOST_CATEGORY_PRICE_MULTIPLIER=2
BOOST_PAYMENT_WEBHOOK_SECRET=replace-with-at-least-32-random-characters

# Authentication (use three independent random secrets in production)
API_SECRET=replace-with-legacy-api-secret
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret

# Data protection. FIXED_IV is only required while legacy CBC records still exist.
KYC_ENCRYPTION_SECRET_KEY=replace-with-at-least-32-random-characters
KYC_ENCRYPTION_FIXED_IV=

# HTTP security
CORS_ALLOWED_ORIGINS=https://seller.example.com,https://admin.example.com
PAYLOAD_LIMIT=1mb

# Email provider
COMMUNICATION_API_URL=https://communication.example.com/api/mail
COMMUNICATION_API_TOKEN=replace-with-provider-token

# Direct media uploads (use an IAM principal restricted to this bucket/prefix)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_S3_BASE_URL=
