{
  "info": {
    "_postman_id": "b6f2d4a7-8c1e-4f3a-9b5d-2e7c1a9f4d60",
    "name": "Campus Shoes - Video (Retailer)",
    "description": "Retailer-facing video library endpoints only (GET /videos, /videos/active, /videos/:id). Create/update/delete are SUPERADMIN-only and not included here — see the Super Admin collection's CMS > Videos folder for those.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4050/api/v1", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string", "description": "JWT for a RETAILER user" },
    { "key": "videoId", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "List videos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/videos?search=&isActive=&page=1&limit=10",
          "host": ["{{baseUrl}}"],
          "path": ["videos"],
          "query": [
            { "key": "search", "value": "", "description": "Matches against title or description" },
            { "key": "isActive", "value": "", "description": "true | false" },
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" }
          ]
        },
        "description": "Response: { videos: [...], pagination: { totalItems, totalPages, currentPage, pageSize } }."
      },
      "response": []
    },
    {
      "name": "Active videos (for my role)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/videos/active",
          "host": ["{{baseUrl}}"],
          "path": ["videos", "active"]
        },
        "description": "Only isActive videos visible to the caller's own role. Matches the 'History > Live Videos' list screen."
      },
      "response": []
    },
    {
      "name": "Video detail",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/videos/{{videoId}}",
          "host": ["{{baseUrl}}"],
          "path": ["videos", "{{videoId}}"]
        },
        "description": "VID_001 if the video doesn't exist."
      },
      "response": []
    }
  ]
}
