    {
      "name": "Admin - Seller KYC Review",
      "item": [
        {
          "name": "List Sellers for KYC Review",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/super-admin/kyc?status=USER_PROFILE_APPROVAL&page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "super-admin",
                "kyc"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "USER_PROFILE_APPROVAL",
                  "disabled": false
                },
                {
                  "key": "page",
                  "value": "1",
                  "disabled": false
                },
                {
                  "key": "limit",
                  "value": "20",
                  "disabled": false
                }
              ]
            },
            "description": "status: NOT_STARTED | PENDING | USER_PROFILE_APPROVAL | APPROVED | REJECTED. USER_PROFILE_APPROVAL = all three of PAN/GST/Aadhaar verified but not yet explicitly approved — this is the queue Approve/Reject act on. Completing KYC alone never auto-approves a seller.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{superAdminAccessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.items && res.data.items.length) {",
                  "    pm.collectionVariables.set('kycSellerId', res.data.items[0].sellerId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Seller KYC Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/super-admin/kyc/{{kycSellerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "super-admin",
                "kyc",
                "{{kycSellerId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{superAdminAccessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Approve Seller KYC (Manual Override)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/super-admin/kyc/{{kycSellerId}}/approve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "super-admin",
                "kyc",
                "{{kycSellerId}}",
                "approve"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{superAdminAccessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Reject Seller KYC (Manual Override)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Document mismatch on submitted PAN.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/super-admin/kyc/{{kycSellerId}}/reject",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "super-admin",
                "kyc",
                "{{kycSellerId}}",
                "reject"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{superAdminAccessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        }
      ],
      "description": "Super Admin only. `:id` here is the seller/user id (from List). Approve/Reject are a manual override — status is otherwise auto-derived once all three of PAN/GST/Aadhaar verify."
    },
