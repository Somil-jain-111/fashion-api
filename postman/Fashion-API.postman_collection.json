    {
      "name": "Seller Onboarding",
      "item": [
        {
          "name": "Onboard as Seller",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storeName\": \"My Fashion Store\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/sellers/onboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sellers",
                "onboard"
              ]
            },
            "description": "Any authenticated account (customer or otherwise) can call this once. Grants the seller_admin role on top of whatever roles the account already holds — no re-login needed, {{accessToken}} works immediately after. PAN/GST/Aadhaar are submitted separately via the Seller KYC folder."
          },
          "response": []
        }
      ]
