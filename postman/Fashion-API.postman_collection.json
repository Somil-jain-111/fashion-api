    {
      "name": "Seller Products",
      "item": [
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"{{categoryId}}\",\n  \"name\": \"Classic Running Shoe\",\n  \"description\": \"Lightweight everyday running shoe.\",\n  \"basePrice\": 1999,\n  \"wholesalePrice\": 1499,\n  \"mrp\": 2499,\n  \"discountPercentage\": 20,\n  \"zone\": \"RETAIL\",\n  \"variants\": [\n    {\n      \"size\": \"UK7\",\n      \"sku\": \"RUN-SHOE-UK7\",\n      \"stockQuantity\": 25\n    },\n    {\n      \"size\": \"UK8\",\n      \"sku\": \"RUN-SHOE-UK8\",\n      \"stockQuantity\": 30\n    }\n  ],\n  \"images\": [\n    {\n      \"url\": \"https://example.com/uploads/shoe-1.jpg\",\n      \"variantIndex\": 0,\n      \"isPrimary\": true,\n      \"sortOrder\": 0\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/sellers/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sellers",
                "products"
              ]
            },
            "description": "Requires approved seller KYC (see Seller KYC folder). basePrice/wholesalePrice/mrp/discountPercentage: currentPrice is always server-derived, never sent. zone: RETAIL | WHOLESALE | BOTH. Created with status PENDING_APPROVAL, pending Super Admin review."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.id) {",
                  "    pm.collectionVariables.set('productId', res.data.id);",
                  "}"
                ]
              }
            }
          ]
        },
