              "path": [
                "categories"
              ]
            },
            "description": "Default body creates a subcategory (parentId: 1) — the case a Seller Admin is allowed to do. Super Admin/Admin may also omit parentId (or send null) to create a top-level category; Seller Admin may not and must have approved KYC."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.id) {",
                  "    pm.collectionVariables.set('categoryId', res.data.id);",
