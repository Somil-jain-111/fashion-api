                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Running Shoes\",\n  \"slug\": \"running-shoes\",\n  \"parentId\": 1,\n  \"imageUrl\": null,\n  \"isActive\": true,\n  \"sortOrder\": 0\n}",
